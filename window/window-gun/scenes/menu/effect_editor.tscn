[sub_resource type="GDScript" id="GDScript_canvas"]
script/source = "extends Control
func _draw() -> void:
	if get_owner() and get_owner().has_method(\"_draw_preview_canvas\"):
		get_owner()._draw_preview_canvas()
"

[sub_resource type="GDScript" id="GDScript_timeline"]
script/source = "extends Control
func _draw() -> void:
	if get_owner() and get_owner().has_method(\"_draw_timeline\"):
		get_owner()._draw_timeline()
"

